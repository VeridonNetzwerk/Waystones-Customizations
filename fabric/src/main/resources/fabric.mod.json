{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": ["${mod_author}"],
  "license": "${mod_license}",
  "contact": {
    "homepage": "https://github.com/VeridonNetzwerk/Waystones-Customizations",
    "sources": "https://github.com/VeridonNetzwerk/Waystones-Customizations",
    "issues": "https://github.com/VeridonNetzwerk/Waystones-Customizations/issues"
  },
  "icon": "waystonescustomizations_icon.png",
  "environment": "client",
  "entrypoints": {
    "client": ["dev.waystonescustomizations.fabric.WaystonesCustomizationsFabric"]
  },
  "mixins": ["waystonescustomizations.mixins.json"],
  "depends": {
    "fabricloader": ">=0.17.0",
    "minecraft": "${fabric_mc_range}",
    "java": ">=25",
    "waystones": "*"
  }
}
